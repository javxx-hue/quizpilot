# Copy to .env and fill in. Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram bot username without @ (enables daily reminders in the user menu)
# VITE_TELEGRAM_BOT=your_bot

# Optional: override the Gemini model when Google retires the default
# VITE_GEMINI_MODEL=gemini-3.8-flash
